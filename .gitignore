# Generated output from audit/benchmark/status runs (may contain machine details)
reports/

# Never commit private data
*.zip
webui.db
uploads/
vector_db/
__pycache__/
*.pyc

# React frontend build tooling — dist/ (the compiled bundle) IS committed,
# it's what ships to the Windows laptop; only the Node toolchain is excluded.
frontend/node_modules/
frontend/build/node_modules/

# demo-dist/ (build/build-demo.mjs's output, for public/Vercel hosting) is
# NOT committed — unlike dist/, its only consumer (Vercel) builds it fresh
# from source every deploy, so a committed copy would just be dead weight.
frontend/demo-dist/
